#!/bin/sh
# Registers or removes the focaltech_spi_fp kernel module with DKMS.
#   dkms-helper enable VERSION   build + install for all kernels, load it
#   dkms-helper disable          remove every registered version
set -u
name=focaltech-spi-fp
src=@DATADIR@/focalprint/dkms-source

disable() {
    command -v dkms >/dev/null 2>&1 || return 0
    for ver in $(dkms status -m "$name" 2>/dev/null | sed -n "s|^$name/\([^,: ]*\).*|\1|p" | sort -u); do
        dkms remove -m "$name" -v "$ver" --all >/dev/null 2>&1 || true
    done
    rm -rf /usr/src/"$name"-*
}

case ${1:-} in
enable)
    ver=${2:?version}
    if ! command -v dkms >/dev/null 2>&1; then
        echo "focalprint: install the 'dkms' package, then run: $0 enable $ver"
        exit 0
    fi
    disable
    dkms add "$src" >/dev/null &&
        dkms install -m "$name" -v "$ver" &&
        modprobe focaltech_spi_fp &&
        echo "focalprint: kernel module focaltech_spi_fp built with DKMS and loaded" ||
        echo "focalprint: building the kernel module failed; see docs/megabook-t1.md" >&2
    ;;
disable) disable ;;
*) echo "usage: dkms-helper enable VERSION | disable" >&2; exit 2 ;;
esac
